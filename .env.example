SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret

PORT=8080

# Optional. Comma-separated list of extra browser origins allowed by CORS.
# Not needed when the dashboard is served from the same origin as the API
# (the default). Set only if you host the PWA on a different origin.
# ALLOWED_ORIGINS=https://nutrition.example.com
